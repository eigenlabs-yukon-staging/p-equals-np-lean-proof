∀ (R : Set (List Bool × List Bool)),
    PEqualNP.Library.DecidableInPolyTime PEqualNP.Library.encodePair R →
    ∀ (p : Polynomial Nat),
    (∀ x : List Bool, (∃ w : List Bool, (x, w) ∈ R) →
      ∃ w : List Bool, (x, w) ∈ R ∧ 2 ^ (w.length + 1) ≤ p.eval x.length + 1) →
    ∃ f : List Bool → List Bool,
      PEqualNP.Library.ComputableInPolyTime (fun x => x) (fun x => x) f ∧
      ∀ x : List Bool,
        (f x = [] ∧ ∀ w : List Bool, (x, w) ∉ R) ∨
          ∃ w : List Bool, f x = true :: w ∧ (x, w) ∈ R
